{
  "name": "metadat-nointro",
  "version": "0.1.0",
  "description": "No-Intro metadat repository - fetches DATs from Dat-o-Matic",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "fetch": "node dist/fetch.js"
  },
  "keywords": [
    "dat",
    "no-intro",
    "rom",
    "preservation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.4.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "fast-xml-parser": "^5.5.11",
    "playwright": "^1.59.1",
    "unzipper": "^0.12.3"
  }
}
